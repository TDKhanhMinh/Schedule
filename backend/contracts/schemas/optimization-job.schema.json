{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schedule.local/contracts/optimization-job.schema.json",
  "title": "BullMQ optimization job envelope",
  "description": "Versioned NestJS to BullMQ to Python boundary. PostgreSQL stores the envelope checksum and result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["queueContractVersion", "runId", "request", "solverPayload", "inputChecksum", "maxAttempts"],
  "properties": {
    "queueContractVersion": {
      "const": "BULLMQ-OPTIMIZATION-1.0.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "object",
      "description": "Canonical SolveJobRequest retained for API provenance.",
      "required": ["schemaVersion", "jobId", "schoolId", "timeSlots", "lessons"],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "schoolId": {
          "type": "string",
          "minLength": 1
        },
        "timeSlots": {
          "type": "array",
          "minItems": 1
        },
        "lessons": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "solverPayload": {
      "type": "object",
      "description": "Raw SolveJobRequest during compatibility window or SOLVER-ADAPTER-1.0.0 envelope when rule snapshot provenance is present."
    },
    "inputChecksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  }
}
