{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schedule.local/contracts/solve-job-result.schema.json",
  "title": "SolveJobResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "status", "assignments", "objectiveValue", "diagnostics", "metadata"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["INVALID", "OPTIMAL", "FEASIBLE", "INFEASIBLE", "UNKNOWN"] },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lessonId", "sessionIndex", "slotId"],
        "properties": {
          "lessonId": { "type": "string", "minLength": 1 },
          "sessionIndex": { "type": "integer", "minimum": 0 },
          "slotId": { "type": "string", "minLength": 1 },
          "roomId": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "objectiveValue": { "type": ["number", "null"] },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warnings", "conflicts"],
      "properties": {
        "warnings": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "catalogVersion": { "const": "CONFLICT-CATALOG-1.0.0" },
        "conflictDetails": {
          "type": "array",
          "items": { "$ref": "conflict-catalog.schema.json#/$defs/diagnostic" }
        },
        "hardConstraintViolations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "objectiveBreakdown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "teacherGap",
            "compactness",
            "dayDistribution",
            "undesirableSlots",
            "preferredDays",
            "fairness",
            "weightedTotal"
          ],
          "properties": {
            "teacherGap": { "type": "integer", "minimum": 0 },
            "compactness": { "type": "integer", "minimum": 0 },
            "dayDistribution": { "type": "integer", "minimum": 0 },
            "undesirableSlots": { "type": "integer", "minimum": 0 },
            "preferredDays": { "type": "integer", "minimum": 0 },
            "fairness": { "type": "integer", "minimum": 0 },
            "weightedTotal": { "type": "integer", "minimum": 0 }
          }
        },
        "runMetrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wallTimeMs", "bestObjectiveBound", "objectiveGapPercent"],
          "properties": {
            "wallTimeMs": { "type": "number", "minimum": 0 },
            "bestObjectiveBound": { "type": ["number", "null"] },
            "objectiveGapPercent": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "localRepair": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "baselineSnapshotHash",
            "affectedAssignmentKeys",
            "frozenAssignmentKeys",
            "movedAssignmentCount",
            "preservedAssignmentCount",
            "outsideScopeUnchanged"
          ],
          "properties": {
            "contractVersion": { "const": "LOCAL-REPAIR-1.0.0" },
            "baselineSnapshotHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "affectedAssignmentKeys": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "frozenAssignmentKeys": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "movedAssignmentCount": { "type": "integer", "minimum": 0 },
            "preservedAssignmentCount": { "type": "integer", "minimum": 0 },
            "outsideScopeUnchanged": { "type": "boolean" }
          }
        },
        "relaxationProposals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "proposalId",
              "rank",
              "kind",
              "targetCode",
              "priorityScore",
              "affectedLessonCount",
              "affectedEntityIds",
              "ruleSource",
              "impact",
              "requiresApproval",
              "autoApply",
              "hardRuleProtected"
            ],
            "properties": {
              "proposalId": { "type": "string", "minLength": 1 },
              "rank": { "type": "integer", "minimum": 1 },
              "kind": { "enum": ["SOFT_RULE_WEIGHT", "STAKEHOLDER_DATA_CHANGE", "STAKEHOLDER_HARD_RULE_REVIEW"] },
              "targetCode": { "type": "string", "minLength": 1 },
              "priorityScore": { "type": "integer", "minimum": 0 },
              "affectedLessonCount": { "type": "integer", "minimum": 0 },
              "affectedEntityIds": { "type": "array", "items": { "type": "string" } },
              "ruleSource": { "type": "object", "additionalProperties": { "type": "string" } },
              "impact": { "type": "string", "minLength": 1 },
              "requiresApproval": { "type": "boolean" },
              "autoApply": { "type": "boolean" },
              "hardRuleProtected": { "type": "boolean" }
            }
          }
        },
        "modelMetrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["variableCount", "candidatePairCount", "domainPrunedCount", "roomDomainCount"],
          "properties": {
            "variableCount": { "type": "integer", "minimum": 0 },
            "candidatePairCount": { "type": "integer", "minimum": 0 },
            "domainPrunedCount": { "type": "integer", "minimum": 0 },
            "roomDomainCount": { "type": "integer", "minimum": 0 }
          }
        },
        "preSolve": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "catalogVersion",
            "canSolve",
            "totalDemandSessions",
            "slotCapacity",
            "issues",
            "warnings"
          ],
          "properties": {
            "contractVersion": { "const": "PRE-SOLVE-1.0.0" },
            "catalogVersion": { "const": "CONFLICT-CATALOG-1.0.0" },
            "canSolve": { "type": "boolean" },
            "totalDemandSessions": { "type": "integer", "minimum": 0 },
            "slotCapacity": { "type": "integer", "minimum": 0 },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "catalogVersion",
                  "code",
                  "severity",
                  "entity",
                  "message",
                  "remediationHint",
                  "entityReferences"
                ],
                "properties": {
                  "catalogVersion": { "const": "CONFLICT-CATALOG-1.0.0" },
                  "code": { "type": "string", "minLength": 1 },
                  "severity": { "enum": ["ERROR", "WARNING"] },
                  "entity": { "enum": ["IMPORT", "JOB", "LESSON", "CLASS", "TEACHER", "ROOM", "SLOT", "RULE"] },
                  "message": { "type": "string", "minLength": 1 },
                  "remediationHint": { "type": "string", "minLength": 1 },
                  "entityReferences": { "type": "object", "additionalProperties": { "type": "string" } },
                  "lessonId": { "type": "string", "minLength": 1 },
                  "resourceId": { "type": "string", "minLength": 1 },
                  "details": { "type": "object" }
                }
              }
            },
            "warnings": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solverVersion", "contractVersion", "randomSeed", "timeLimitSeconds"],
      "dependentRequired": {
        "ruleSnapshotId": ["ruleSetVersion", "ruleSnapshotHash"],
        "ruleSetVersion": ["ruleSnapshotId", "ruleSnapshotHash"],
        "ruleSnapshotHash": ["ruleSnapshotId", "ruleSetVersion"]
      },
      "properties": {
        "solverVersion": { "type": "string", "minLength": 1 },
        "contractVersion": { "const": "1.0" },
        "randomSeed": { "type": "integer" },
        "timeLimitSeconds": {
          "anyOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }]
        },
        "adapterContractVersion": { "const": "SOLVER-ADAPTER-1.0.0" },
        "templateVersion": { "type": "string", "minLength": 1 },
        "academicPeriodId": { "type": "string", "minLength": 1 },
        "inputChecksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "ruleSnapshotId": { "type": "string", "minLength": 1 },
        "ruleSetVersion": { "type": "string", "pattern": "^RULE-SET-[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "ruleSnapshotHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "objectiveContractVersion": { "const": "SOLVER-OBJECTIVE-1.0.0" }
      }
    }
  }
}
