{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schedule.local/contracts/solve-job-result.schema.json",
  "title": "SolveJobResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "status", "assignments", "objectiveValue", "diagnostics", "metadata"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "jobId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["OPTIMAL", "FEASIBLE", "INFEASIBLE", "UNKNOWN"] },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lessonId", "sessionIndex", "slotId"],
        "properties": {
          "lessonId": { "type": "string", "minLength": 1 },
          "sessionIndex": { "type": "integer", "minimum": 0 },
          "slotId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "objectiveValue": { "type": ["number", "null"] },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warnings", "conflicts"],
      "properties": {
        "warnings": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solverVersion", "contractVersion", "randomSeed", "timeLimitSeconds"],
      "dependentRequired": {
        "ruleSnapshotId": ["ruleSetVersion", "ruleSnapshotHash"],
        "ruleSetVersion": ["ruleSnapshotId", "ruleSnapshotHash"],
        "ruleSnapshotHash": ["ruleSnapshotId", "ruleSetVersion"]
      },
      "properties": {
        "solverVersion": { "type": "string", "minLength": 1 },
        "contractVersion": { "const": "1.0" },
        "randomSeed": { "type": "integer" },
        "timeLimitSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "ruleSnapshotId": { "type": "string", "minLength": 1 },
        "ruleSetVersion": { "type": "string", "pattern": "^RULE-SET-[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "ruleSnapshotHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
