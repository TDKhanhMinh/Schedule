{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schedule.local/contracts/rule-set-snapshot.schema.json",
  "title": "RuleSetSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshotId",
    "ruleSetVersion",
    "profileVersion",
    "registerVersion",
    "sourceUrl",
    "effectiveFrom",
    "scope",
    "approvalState",
    "rules",
    "snapshotHash",
    "capturedAt",
    "capturedBy"
  ],
  "properties": {
    "snapshotId": { "type": "string", "minLength": 1 },
    "ruleSetVersion": { "type": "string", "pattern": "^RULE-SET-[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "profileVersion": { "type": "string", "minLength": 1 },
    "registerVersion": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string", "format": "uri" },
    "sourceLocator": { "type": "string", "minLength": 1 },
    "effectiveFrom": { "type": "string", "format": "date" },
    "effectiveTo": { "type": ["string", "null"], "format": "date" },
    "scope": { "$ref": "#/$defs/ruleScope" },
    "approvalState": {
      "enum": ["PENDING_STAKEHOLDER", "APPROVED", "REVOKED"]
    },
    "approvedBy": { "type": "string", "minLength": 1 },
    "approvedAt": { "$ref": "#/$defs/canonicalTimestamp" },
    "approvalReason": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ruleDefinition" }
    },
    "snapshotHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capturedAt": { "$ref": "#/$defs/canonicalTimestamp" },
    "capturedBy": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "approvalState": { "const": "APPROVED" } } },
      "then": { "required": ["approvedBy", "approvedAt"] }
    }
  ],
  "$defs": {
    "canonicalTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "ruleScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schoolId": { "type": "string", "minLength": 1 },
        "academicPeriodId": { "type": "string", "minLength": 1 },
        "schoolLevel": { "enum": ["THCS", "THPT", "THCS_THPT"] },
        "actorType": { "enum": ["SYSTEM", "SCHOOL", "TEACHER"] },
        "actorId": { "type": "string", "minLength": 1 },
        "resourceType": { "enum": ["SCHOOL", "TEACHER", "CLASS", "SUBJECT", "ROOM"] },
        "resourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "ruleDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "kind", "weight", "sourceUrl", "effectiveFrom", "scope", "approvalState", "parameters"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]+$" },
        "kind": { "enum": ["HARD", "SOFT"] },
        "weight": { "type": ["number", "null"], "minimum": 0 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "sourceLocator": { "type": "string", "minLength": 1 },
        "effectiveFrom": { "type": "string", "format": "date" },
        "effectiveTo": { "type": ["string", "null"], "format": "date" },
        "scope": { "$ref": "#/$defs/ruleScope" },
        "approvalState": {
          "enum": ["PENDING_STAKEHOLDER", "APPROVED", "REVOKED"]
        },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "$ref": "#/$defs/canonicalTimestamp" },
        "approvalReason": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "SOFT" } } },
          "then": { "required": ["weight"] }
        },
        {
          "if": { "properties": { "kind": { "const": "HARD" } } },
          "then": { "properties": { "weight": { "type": "null" } } }
        },
        {
          "if": { "properties": { "approvalState": { "const": "APPROVED" } } },
          "then": { "required": ["approvedBy", "approvedAt"] }
        }
      ]
    }
  }
}
