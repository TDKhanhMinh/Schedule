{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schedule.local/contracts/rule-catalog.schema.json",
  "title": "RuleCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "schemaVersion", "ruleTypes"],
  "properties": {
    "catalogVersion": { "const": "RULE-CATALOG-1.0.0" },
    "schemaVersion": { "const": "1.0" },
    "ruleTypes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ruleType" }
    }
  },
  "$defs": {
    "ruleType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "group",
        "targetResources",
        "supportedKinds",
        "defaultKind",
        "implementationStatus",
        "handlerKey",
        "description",
        "parameters"
      ],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]+$" },
        "codePrefixes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "name": { "type": "string", "minLength": 1 },
        "group": { "enum": ["TEACHER", "CLASS", "SUBJECT", "ROOM", "SCHEDULE"] },
        "targetResources": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["SCHOOL", "TEACHER", "CLASS", "SUBJECT", "ROOM"] }
        },
        "supportedKinds": { "type": "array", "minItems": 1, "items": { "enum": ["HARD", "SOFT"] } },
        "defaultKind": { "enum": ["HARD", "SOFT"] },
        "defaultWeight": { "type": "number", "minimum": 0 },
        "implementationStatus": { "enum": ["SUPPORTED", "PLANNED"] },
        "handlerKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "description": { "type": "string", "minLength": 1 },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type", "required"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
        "label": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "BOOLEAN",
            "DAY_OF_WEEK",
            "DAY_OF_WEEK_LIST",
            "GRANULARITY",
            "INTEGER",
            "PERIOD",
            "SHIFT_CODE",
            "SLOT_ID",
            "TEXT"
          ]
        },
        "required": { "type": "boolean" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minItems": { "type": "integer", "minimum": 1 },
        "maxItems": { "type": "integer", "minimum": 1 },
        "options": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
