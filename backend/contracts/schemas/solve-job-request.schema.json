{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schedule.local/contracts/solve-job-request.schema.json",
  "title": "SolveJobRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId", "schoolId", "timeSlots", "lessons"],
  "dependentRequired": {
    "ruleSnapshotId": ["ruleSetVersion", "ruleSnapshotHash"],
    "ruleSetVersion": ["ruleSnapshotId", "ruleSnapshotHash"],
    "ruleSnapshotHash": ["ruleSnapshotId", "ruleSetVersion"]
  },
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "jobId": { "type": "string", "minLength": 1 },
    "schoolId": { "type": "string", "minLength": 1 },
    "ruleSnapshotId": { "type": "string", "minLength": 1 },
    "ruleSetVersion": { "type": "string", "pattern": "^RULE-SET-[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "ruleSnapshotHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timeSlots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "day", "period"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "day": { "type": "integer", "minimum": 1, "maximum": 7 },
          "period": { "type": "integer", "minimum": 1 },
          "shiftCode": { "type": "string", "minLength": 1 }
        }
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "classId", "subjectId", "teacherId", "requiredSessions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "classId": { "type": "string", "minLength": 1 },
          "subjectId": { "type": "string", "minLength": 1 },
          "teacherId": { "type": "string", "minLength": 1 },
          "requiredSessions": { "type": "integer", "minimum": 1 },
          "allowedSlotIds": { "type": "array", "items": { "type": "string" } },
          "fixedSlotId": { "type": "string", "minLength": 1 },
          "allowedRoomIds": { "type": "array", "items": { "type": "string" } },
          "requiredRoomCapabilities": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "teacherAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "schoolId",
        "academicPeriodId",
        "effectiveAsOf",
        "ruleSnapshotId",
        "ruleSetVersion",
        "ruleSnapshotHash",
        "rules"
      ],
      "properties": {
        "contractVersion": { "const": "TEACHER-AVAILABILITY-1.0.0" },
        "schoolId": { "type": "string", "minLength": 1 },
        "academicPeriodId": { "type": "string", "minLength": 1 },
        "effectiveAsOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "ruleSnapshotId": { "type": "string", "minLength": 1 },
        "ruleSetVersion": { "type": "string", "pattern": "^RULE-SET-[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "ruleSnapshotHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ruleId",
              "code",
              "teacherId",
              "strength",
              "weight",
              "dayOfWeek",
              "blockedSlotIds",
              "effectiveFrom",
              "source"
            ],
            "properties": {
              "ruleId": { "type": "string", "minLength": 1 },
              "code": { "type": "string", "minLength": 1 },
              "teacherId": { "type": "string", "minLength": 1 },
              "strength": { "enum": ["HARD_UNAVAILABLE", "STRONG_PREFERENCE", "SOFT_WISH"] },
              "weight": { "type": ["number", "null"], "minimum": 0 },
              "dayOfWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
              "shiftCode": { "type": "string", "minLength": 1 },
              "period": { "type": "integer", "minimum": 1 },
              "blockedSlotIds": { "type": "array", "items": { "type": "string" } },
              "effectiveFrom": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "effectiveTo": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "reason": { "type": "string", "minLength": 1 },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sourceUrl", "ruleSnapshotId", "ruleSetVersion", "ruleSnapshotHash"],
                "properties": {
                  "sourceUrl": { "type": "string", "minLength": 1 },
                  "sourceLocator": { "type": "string", "minLength": 1 },
                  "ruleSnapshotId": { "type": "string", "minLength": 1 },
                  "ruleSetVersion": { "type": "string", "pattern": "^RULE-SET-[0-9]+\\.[0-9]+\\.[0-9]+$" },
                  "ruleSnapshotHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                }
              }
            }
          }
        }
      }
    },
    "classUnavailableSlotIds": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capabilities"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "capabilities": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional solver controls. If omitted, timeLimitSeconds defaults to 10 seconds and the runner random seed defaults to 0.",
      "properties": {
        "timeLimitSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 10
        }
      }
    }
  }
}
