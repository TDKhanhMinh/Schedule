{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schedule.local/contracts/conflict-catalog.schema.json",
  "title": "ConflictCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "definitions"],
  "properties": {
    "catalogVersion": { "const": "CONFLICT-CATALOG-1.0.0" },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/definition" }
    }
  },
  "$defs": {
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "entity", "messageTemplateVi", "remediationHintVi"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["ERROR", "WARNING", "INFO"] },
        "entity": { "enum": ["IMPORT", "JOB", "LESSON", "CLASS", "TEACHER", "ROOM", "SLOT", "RULE"] },
        "messageTemplateVi": { "type": "string", "minLength": 1 },
        "remediationHintVi": { "type": "string", "minLength": 1 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogVersion", "code", "severity", "entity", "message", "remediationHint", "entityReferences"],
      "properties": {
        "catalogVersion": { "const": "CONFLICT-CATALOG-1.0.0" },
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["ERROR", "WARNING", "INFO"] },
        "entity": { "enum": ["IMPORT", "JOB", "LESSON", "CLASS", "TEACHER", "ROOM", "SLOT", "RULE"] },
        "message": { "type": "string", "minLength": 1 },
        "remediationHint": { "type": "string", "minLength": 1 },
        "entityReferences": { "type": "object", "additionalProperties": { "type": "string" } },
        "conflictChain": { "$ref": "#/$defs/conflictChain" }
      }
    },
    "conflictChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "chainId", "rootCode", "nodes", "edges"],
      "properties": {
        "contractVersion": { "const": "CONFLICT-CHAIN-1.0.0" },
        "chainId": { "type": "string", "minLength": 1 },
        "rootCode": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodeId", "type", "label", "references"],
            "properties": {
              "nodeId": { "type": "string", "minLength": 1 },
              "type": { "enum": ["CONSTRAINT", "ENTITY", "OUTCOME"] },
              "label": { "type": "string", "minLength": 1 },
              "references": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "relation"],
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "relation": { "enum": ["CAUSES", "RESULTS_IN"] }
            }
          }
        }
      }
    }
  }
}
