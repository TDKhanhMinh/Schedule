{
  "name": "@schedule/backend",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./contracts": {
      "types": "./src/contracts/index.ts",
      "default": "./src/contracts/index.ts"
    },
    "./subject-code": {
      "types": "./src/contracts/subject-code.ts",
      "default": "./src/contracts/subject-code.ts"
    }
  },
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint --config eslint.config.mjs .",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "worker": "node dist/worker/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "pdfkit": "^0.20.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.2.5",
    "typescript-eslint": "^8.67.0"
  }
